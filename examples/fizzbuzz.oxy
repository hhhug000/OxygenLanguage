def fizzbuzz(length)
    i = 1
    while i <= length do
        if i % 15 == 0 then
            print("FizzBuzz")
        elif i % 3 == 0 then
            print("Fizz")
        elif i % 5 == 0 then
            print("Buzz")
        else
            print(i)
        end

        i = i + 1
    end
end

fizzbuzz(100)